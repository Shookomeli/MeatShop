# MeatShop Environment Configuration

# Security key for Django session signing and cryptography
SECRET_KEY=django-insecure-replace-this-in-production

# Enable debug mode (True for development, False for production)
DEBUG=True

# Hardware Scale integration mode:
# 'mock'             - High-fidelity software simulator for development/testing
# 'keli_xk3118t1'    - Hardware serial integration (Phase 11+)
SCALE_MODE=mock

# Currency display formatting:
# 'RIAL' (default) - All monetary displays, printed documents and reports are shown in Rial.
# Toman (1 Toman = 10 Rial) appears only as an approximate hint under price-entry fields.
# NOTE: All monetary database fields store whole-number Rial values regardless of this setting.
CURRENCY_DISPLAY_UNIT=RIAL

# SQLite database path:
# Default in development: db.sqlite3 in project root
# Production path: C:\MeatShop\data\db.sqlite3
# DATABASE_PATH=C:\MeatShop\data\db.sqlite3